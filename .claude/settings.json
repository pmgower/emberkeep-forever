{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(**/WTF/**)",
      "Edit(**/WTF/**)",
      "Write(**/WTF/**)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push origin v*)",
      "Bash(git push origin refs/tags/*)",
      "Bash(git push * -f *)",
      "Bash(git push * --force *)",
      "Bash(git push *+*)",
      "Bash(git push *refs/tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push * tag *)",
      "Bash(git -C * push*)",
      "Bash(git push upstream v*)",
      "Bash(gh release *)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *git/tags*)",
      "Bash(gh api *releases*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "luarocks.org",
        "raw.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "~/.ssh"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/gate.sh"
          }
        ]
      }
    ]
  }
}
